{
  "name": "Tidy-Tokens",
  "version": "1.0.0",
  "description": "Your Figma Plugin",
  "main": "code.js",
  "scripts": {
    "coverage": "vitest run --coverage --coverage.include=\"src/core/**\"",
    "build": "esbuild src/main/code.ts --bundle --target=es2017 --outfile=code.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "esbuild src/main/code.ts --bundle --target=es2017 --outfile=code.js --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^5.1.0"
  }
}
